@model Lwesihlanu.Models.Report

<h1>Run Report: @Model.Name</h1>

<form asp-action="Run">
    <input type="hidden" asp-for="ReportId" />
    <div class="form-group">
        <label>Selected Columns:</label>
        <ul>
            @foreach (var column in Model.ReportColumns)
            {
                <li>@column.Name</li>
            }
        </ul>
    </div>
  @*   <div class="form-group">
        <label>Filters:</label>
        <input type="text" asp-for="Filters" class="form-control" />
    </div> *@
    <button type="submit" class="btn btn-primary">Run Report</button>
</form>
