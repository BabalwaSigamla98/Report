@model IEnumerable<Lwesihlanu.Models.Report>

<h1>Reports</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <!-- Add more table headers if needed -->
            <th></th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model)
        {
            <tr>
                <td>@report.Name</td>
                <td>@report.Description</td>
                <!-- Add more table cells with report properties -->
                <td><a asp-action="Edit" asp-route-id="@report.ReportId">Edit</a></td>
                <td><a asp-action="Details" asp-route-id="@report.ReportId">Details</a></td>
                <td><a asp-action="Delete" asp-route-id="@report.ReportId">Delete</a></td>
                <td><a asp-action="Run" asp-route-id="@report.ReportId">Run</a></td>
                <td><a asp-action="Clone" asp-route-id="@report.ReportId">Clone</a></td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New</a>
